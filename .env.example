# ---- Resend (radiologist sign-off email) ----
RESEND_API_KEY=
# Dev: use onboarding@resend.dev (Resend only delivers to your Resend signup email).
# Prod: verify a domain at resend.com/domains, then use e.g. notify@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Recall
# Who receives the approve/reject sign-off email (your real inbox)
RADIOLOGIST_EMAIL=

# Demo: override patient phone for all outbound Twilio dials (E.164 or 10-digit US)
DEMO_PATIENT_PHONE=+14043331778

# ---- Supabase (Postgres + realtime + storage) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=reports

# ---- Arize Phoenix (tracing + evals) ----
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# ---- Sign-off + URLs ----
SIGNOFF_JWT_SECRET=
# Twilio voice webhooks only — public https URL of the FastAPI service (Render/ngrok)
PUBLIC_API_BASE_URL=
# Deployed dashboard — sign-off email links use {WEB_PUBLIC_URL}/api/signoff/...
WEB_PUBLIC_URL=https://recall.pics

# ---- Web (Next.js on Vercel) ----
